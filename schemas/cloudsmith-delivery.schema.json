{
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "release",
    "images",
    "charts",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "release": {
      "type": "object",
      "required": [
        "id",
        "tag",
        "commit",
        "manifestSha256"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "source",
          "destination",
          "digest",
          "attachments",
          "referrers"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "destination",
                "digest"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "destination": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "referrers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "charts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "source",
          "destination",
          "sha256",
          "format",
          "packageId"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "const": "https://dl.cloudsmith.io/basic/eqtylab/prod/helm/charts/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "format": {
            "const": "helm"
          },
          "packageId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "packageName",
          "version",
          "sha256",
          "packageId",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "packageName": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "packageId": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://dl\\.cloudsmith\\.io/basic/eqtylab/prod/raw/names/"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified Cloudsmith platform delivery"
}
